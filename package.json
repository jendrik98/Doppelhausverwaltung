{
  "name": "mietverwaltung-live-e2e",
  "private": true,
  "version": "1.0.1",
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:validation": "node scripts/test-validation.mjs",
    "test:architecture": "node scripts/test-architecture.mjs && npm run test:portfolio && npm run test:repository && npm run test:application",
    "test:portfolio": "node scripts/test-portfolio-model.mjs",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "test:quality": "node scripts/test-quality.mjs",
    "test:pwa": "node scripts/test-pwa-update.mjs",
    "test:repository": "node scripts/test-portfolio-repository.mjs",
    "test:application": "node scripts/test-application-layer.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  }
}
